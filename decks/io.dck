VERSION 18

CONSTANTS 3
START=0
STOP=750000
STEP=1
SIMULATION 	 START	 STOP	 STEP
TOLERANCES 0.001 0.001
LIMITS 30 30 30
DFQ 1
WIDTH 80
NOLIST

SOLVER 0 1 1
NAN_CHECK 0
OVERWRITE_CHECK 0
TIME_REPORT 0
EQSOLVER 0
*$USER_CONSTANTS
*$USER_CONSTANTS_END

UNIT 2 TYPE 3830	 Type3830
PARAMETERS 2
30		! 1 Logical unit
STEP		! 2 Printing interval
*** External files
ASSIGN "***.tmp" 30

END
